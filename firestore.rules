rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Helper Functions

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function deletionPath(uid) {
      return /databases/$(database)/documents/deletion_requests/$(uid);
    }

    function reportPath(reportId) {
      return /databases/$(database)/documents/post_reports/$(reportId);
    }

    function isActive() {
      return isSignedIn() &&
        exists(userPath(request.auth.uid)) &&
        get(userPath(request.auth.uid)).data.account_status == 'active' &&
        get(userPath(request.auth.uid)).data.role in ['user', 'admin'];
    }

    function isAdmin() {
      return isActive() &&
        get(userPath(request.auth.uid)).data.role == 'admin';
    }

    function hasPendingDeletion(uid) {
      return existsAfter(deletionPath(uid)) &&
        getAfter(deletionPath(uid)).data.status
          in ['pending', 'approved', 'completed'];
    }

    function validReportedPost(postId, reportedUserId) {
      return postId is string &&
        postId.size() > 0 &&
        reportedUserId is string &&
        exists(/databases/$(database)/documents/posts/$(postId)) &&
        get(/databases/$(database)/documents/posts/$(postId))
          .data.userId == reportedUserId;
    }

    function validDeletionReport(reportId, uid) {
      return reportId is string &&
        exists(reportPath(reportId)) &&
        get(reportPath(reportId)).data.reportedUserId == uid &&
        get(reportPath(reportId)).data.status
          in ['pending', 'resolved'];
    }

    // 2. User Profiles

    match /users/{userId} {

      allow create: if isOwner(userId) &&
        !exists(deletionPath(userId)) &&
        request.resource.data.uid == userId &&
        request.resource.data.role == 'user' &&
        request.resource.data.account_status == 'active';

      allow get: if isOwner(userId) || isAdmin();

      allow list: if isAdmin();

      allow update: if isOwner(userId) &&
        isActive() &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['full_name', 'phone_number']);

      allow update: if isAdmin() &&
        request.auth.uid != userId &&
        resource.data.role == 'user' &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['account_status']) &&
        request.resource.data.account_status
          in ['active', 'banned', 'disabled'] &&
        (
          !hasPendingDeletion(userId) ||
          request.resource.data.account_status == 'disabled'
        );

      allow delete: if false;

      // 3. Saved Animals

      match /savedPosts/{postId} {
        allow read, create, update, delete:
          if isOwner(userId) && isActive();
      }

      // 4. Donation Intent Records

      match /donations/{donationId} {

        allow create: if isOwner(userId) &&
          isActive() &&
          request.resource.data.keys().hasAll([
            'amount',
            'currency',
            'status',
            'created_at'
          ]) &&
          request.resource.data.keys().hasOnly([
            'amount',
            'currency',
            'status',
            'created_at'
          ]) &&
          request.resource.data.amount is int &&
          request.resource.data.amount > 0 &&
          request.resource.data.amount <= 1000000 &&
          request.resource.data.currency == 'LKR' &&
          request.resource.data.status == 'pending' &&
          request.resource.data.created_at == request.time;

        allow read: if
          (isOwner(userId) && isActive()) || isAdmin();

        allow update, delete: if false;
      }
    }

    // 5. Animal Posts

    match /posts/{postId} {

      allow read: if isActive();

      allow create: if isActive() &&
        request.resource.data.userId == request.auth.uid;

      allow update: if isActive() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;

      allow delete: if isActive() &&
        resource.data.userId == request.auth.uid;
    }

    // 6. Adoption Applications

    match /adoption_applications/{applicationId} {

      allow create: if isActive() &&
        request.resource.data.applicantId == request.auth.uid &&
        request.resource.data.status == 'Pending';

      allow read: if isActive() &&
        (
          resource.data.applicantId == request.auth.uid ||
          isAdmin()
        );

      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['status']) &&
        request.resource.data.status
          in ['Pending', 'Approved', 'Rejected'];

      allow delete: if false;
    }

    // 7. Tender Care Records

    match /tender_records/{recordId} {

      allow create: if isActive() &&

        request.resource.data.keys().hasAll([
          'postId',
          'animalName',
          'reporterId',
          'caregiverId',
          'careTypes',
          'description',
          'evidenceImageUrl',
          'status',
          'createdAt'
        ]) &&

        request.resource.data.keys().hasOnly([
          'postId',
          'animalName',
          'reporterId',
          'caregiverId',
          'careTypes',
          'description',
          'evidenceImageUrl',
          'status',
          'createdAt'
        ]) &&

        request.resource.data.caregiverId == request.auth.uid &&

        request.resource.data.postId is string &&
        request.resource.data.postId.size() > 0 &&
        request.resource.data.postId.size() <= 200 &&

        exists(
          /databases/$(database)/documents/posts/$(request.resource.data.postId)
        ) &&

        request.resource.data.animalName is string &&
        request.resource.data.animalName.size() <= 150 &&

        request.resource.data.reporterId is string &&
        request.resource.data.reporterId.size() <= 200 &&

        request.resource.data.careTypes is list &&
        request.resource.data.careTypes.size() > 0 &&
        request.resource.data.careTypes.size() <= 4 &&

        request.resource.data.careTypes.hasOnly([
          'Food',
          'Water',
          'Medical Assistance',
          'Shelter'
        ]) &&

        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 &&
        request.resource.data.description.size() <= 1000 &&

        request.resource.data.evidenceImageUrl is string &&
        request.resource.data.evidenceImageUrl.matches(
          '^https://res\\.cloudinary\\.com/mdpqtvkq/image/upload/.*$'
        ) &&

        request.resource.data.status == 'Submitted' &&
        request.resource.data.createdAt == request.time;

      allow read: if isActive() &&
        (
          resource.data.caregiverId == request.auth.uid ||
          isAdmin()
        );

      allow update, delete: if false;
    }

    // 8. Post Reports

    match /post_reports/{reportId} {

      allow create: if isActive() &&

        request.resource.data.keys().hasAll([
          'postId',
          'reporterId',
          'reportedUserId',
          'reason',
          'description',
          'status',
          'createdAt',
          'resolvedAt',
          'resolvedBy'
        ]) &&

        request.resource.data.keys().hasOnly([
          'postId',
          'reporterId',
          'reportedUserId',
          'reason',
          'description',
          'status',
          'createdAt',
          'resolvedAt',
          'resolvedBy'
        ]) &&

        request.resource.data.reporterId == request.auth.uid &&

        validReportedPost(
          request.resource.data.postId,
          request.resource.data.reportedUserId
        ) &&

        request.resource.data.reason in [
          'Misleading animal information',
          'Suspected scam',
          'Inappropriate content',
          'Animal welfare concern',
          'Other'
        ] &&

        request.resource.data.description is string &&
        request.resource.data.description.size() <= 1000 &&

        (
          request.resource.data.reason != 'Other' ||
          request.resource.data.description.size() > 0
        ) &&

        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.resolvedAt == null &&
        request.resource.data.resolvedBy == null;

      allow get: if isAdmin() ||
        (
          isActive() &&
          resource.data.reporterId == request.auth.uid
        );

      allow list: if isAdmin();

      allow update: if isAdmin() &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'resolvedAt',
            'resolvedBy'
          ]) &&
        request.resource.data.status
          in ['resolved', 'dismissed'] &&
        request.resource.data.resolvedBy == request.auth.uid &&
        request.resource.data.resolvedAt == request.time;

      allow delete: if false;
    }

    // 9. User Deletion Requests

    match /deletion_requests/{userId} {

      allow get, list: if isAdmin();

      allow create: if isAdmin() &&
        request.auth.uid != userId &&

        request.resource.data.keys().hasAll([
          'userId',
          'reportId',
          'requestedBy',
          'reason',
          'status',
          'createdAt'
        ]) &&

        request.resource.data.keys().hasOnly([
          'userId',
          'reportId',
          'requestedBy',
          'reason',
          'status',
          'createdAt'
        ]) &&

        request.resource.data.userId == userId &&
        request.resource.data.requestedBy == request.auth.uid &&

        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.reason.size() <= 500 &&

        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&

        exists(userPath(userId)) &&
        get(userPath(userId)).data.role == 'user' &&

        validDeletionReport(
          request.resource.data.reportId,
          userId
        ) &&

        getAfter(userPath(userId))
          .data.account_status == 'disabled';

      allow update, delete: if false;
    }

    // 10. Default Security

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
