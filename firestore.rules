
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================
    // HELPER FUNCTIONS
    // =====================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() &&
        request.auth.uid == userId;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function deletionPath(uid) {
      return /databases/$(database)/documents/deletion_requests/$(uid);
    }

    function reportPath(reportId) {
      return /databases/$(database)/documents/post_reports/$(reportId);
    }

    function isActive() {
      return isSignedIn() &&
        exists(userPath(request.auth.uid)) &&
        get(userPath(request.auth.uid))
          .data.account_status == 'active' &&
        get(userPath(request.auth.uid))
          .data.role in ['user', 'admin'];
    }

    function isAdmin() {
      return isActive() &&
        get(userPath(request.auth.uid))
          .data.role == 'admin';
    }

    function validReportedPost(postId, reportedUserId) {
      return postId is string &&
        reportedUserId is string &&
        exists(
          /databases/$(database)/documents/posts/$(postId)
        ) &&
        get(
          /databases/$(database)/documents/posts/$(postId)
        ).data.userId == reportedUserId;
    }

    // Check whether a deletion request is pending

    function hasPendingDeletion(uid) {
      return existsAfter(deletionPath(uid)) &&
        getAfter(deletionPath(uid))
          .data.status in ['pending', 'approved', 'completed'];
    }

    // Validate report before requesting deletion

    function validDeletionReport(reportId, uid) {
      return reportId is string &&
        exists(reportPath(reportId)) &&
        get(reportPath(reportId))
          .data.reportedUserId == uid &&
        get(reportPath(reportId))
          .data.status in ['pending', 'resolved'];
    }

    // =====================================
    // 1. USER PROFILES
    // =====================================

    match /users/{userId} {

      allow create: if isOwner(userId) &&
        !exists(deletionPath(userId)) &&
        request.resource.data.uid == userId &&
        request.resource.data.role == 'user' &&
        request.resource.data.account_status == 'active';

      allow get: if isOwner(userId) || isAdmin();

      allow list: if isAdmin();

      // Users can edit own profile

      allow update: if isOwner(userId) &&
        isActive() &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'full_name',
            'phone_number'
          ]);

      // Admin can manage normal user accounts

      allow update: if isAdmin() &&
        request.auth.uid != userId &&
        resource.data.role == 'user' &&

        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['account_status']) &&

        request.resource.data.account_status in [
          'active',
          'banned',
          'disabled'
        ] &&

        (
          !hasPendingDeletion(userId) ||
          request.resource.data.account_status == 'disabled'
        );

      // Permanent deletion requires authorized review

      allow delete: if false;

      // =====================================
      // 2. SAVED ANIMALS
      // =====================================

      match /savedPosts/{postId} {

        allow read, create, update, delete:
          if isOwner(userId) && isActive();
      }
    }

    // =====================================
    // 3. ANIMAL POSTS
    // =====================================

    match /posts/{postId} {

      allow read: if isActive();

      allow create: if isActive() &&
        request.resource.data.userId ==
          request.auth.uid;

      allow update: if isActive() &&
        resource.data.userId ==
          request.auth.uid &&
        request.resource.data.userId ==
          resource.data.userId;

      allow delete: if isActive() &&
        resource.data.userId ==
          request.auth.uid;
    }

    // =====================================
    // 4. ADOPTION APPLICATIONS
    // =====================================

    match /adoption_applications/{applicationId} {

      allow create: if isActive() &&
        request.resource.data.applicantId ==
          request.auth.uid &&
        request.resource.data.status == 'Pending';

      allow read: if isActive() &&
        (
          resource.data.applicantId ==
            request.auth.uid ||
          isAdmin()
        );

      allow update: if isAdmin() &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['status']) &&
        request.resource.data.status in [
          'Pending',
          'Approved',
          'Rejected'
        ];

      allow delete: if false;
    }

    // =====================================
    // 5. POST REPORTS
    // =====================================

    match /post_reports/{reportId} {

      allow create: if isActive() &&

        request.resource.data.keys().hasAll([
          'postId',
          'reporterId',
          'reportedUserId',
          'reason',
          'description',
          'status',
          'createdAt',
          'resolvedAt',
          'resolvedBy'
        ]) &&

        request.resource.data.keys().hasOnly([
          'postId',
          'reporterId',
          'reportedUserId',
          'reason',
          'description',
          'status',
          'createdAt',
          'resolvedAt',
          'resolvedBy'
        ]) &&

        request.resource.data.reporterId ==
          request.auth.uid &&

        validReportedPost(
          request.resource.data.postId,
          request.resource.data.reportedUserId
        ) &&

        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.reason.size() <= 200 &&

        request.resource.data.description is string &&
        request.resource.data.description.size() <= 1000 &&

        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.resolvedAt == null &&
        request.resource.data.resolvedBy == null;

      allow get: if isAdmin() ||
        (
          isActive() &&
          resource.data.reporterId ==
            request.auth.uid
        );

      allow list: if isAdmin();

      allow update: if isAdmin() &&

        resource.data.status == 'pending' &&

        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'resolvedAt',
            'resolvedBy'
          ]) &&

        request.resource.data.status in [
          'resolved',
          'dismissed'
        ] &&

        request.resource.data.resolvedBy ==
          request.auth.uid &&

        request.resource.data.resolvedAt ==
          request.time;

      allow delete: if false;
    }

    // =====================================
    // 6. USER DELETION REQUESTS
    // =====================================

    match /deletion_requests/{userId} {

      // Only active administrators can view requests

      allow get, list: if isAdmin();

      // Only administrators can request deletion

      allow create: if isAdmin() &&

        request.auth.uid != userId &&

        request.resource.data.keys().hasAll([
          'userId',
          'reportId',
          'requestedBy',
          'reason',
          'status',
          'createdAt'
        ]) &&

        request.resource.data.keys().hasOnly([
          'userId',
          'reportId',
          'requestedBy',
          'reason',
          'status',
          'createdAt'
        ]) &&

        request.resource.data.userId == userId &&

        request.resource.data.requestedBy ==
          request.auth.uid &&

        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.reason.size() <= 500 &&

        request.resource.data.status == 'pending' &&

        request.resource.data.createdAt ==
          request.time &&

        exists(userPath(userId)) &&

        get(userPath(userId)).data.role == 'user' &&

        validDeletionReport(
          request.resource.data.reportId,
          userId
        ) &&

        // Account must be disabled in the transaction

        getAfter(userPath(userId))
          .data.account_status == 'disabled';

      // Prevent modifying or removing audit records
      // through the client application

      allow update, delete: if false;
    }

    // =====================================
    // 7. DEFAULT SECURITY
    // =====================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
